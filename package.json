{
  "name": "varun-portfolio",
  "version": "1.0.0",
  "private": true,
  "homepage": "https://varun-saxena314.github.io",
  "dependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.3",
    "react-scripts": "5.0.1",
    "typewriter-effect": "^2.21.0",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "cpy-cli": "^6.0.0",
    "rimraf": "^6.1.0",
    "shx": "^0.3.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",

    "clean-docs": "rimraf ./docs && mkdir docs",
    "copy-to-docs": "cpy \"build/**\" ./docs --parents && shx touch docs/.nojekyll",

    "deploy": "npm run build && npm run clean-docs && npm run copy-to-docs && git add docs && git commit -m \"Deploy updated site\" || echo \"No changes to commit\" && git push",

    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "postdeploy": "rimraf build"
  },
  "eslintConfig": {
    "extends": ["react-app", "react-app/jest"]
  },
  "browserslist": {
    "production": [">0.2%", "not dead", "not op_mini all"],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
